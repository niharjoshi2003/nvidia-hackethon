{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/api/(grade|collect)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
