# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Server side only. Never prefixed with VITE_, never reaches the browser. ---
# The grading endpoint (api/grade.ts) reads these. The key stays on the server.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Model ids, copied verbatim from the Token Factory catalog.
# Run `npm run spike` to print the ids that are actually served.
NEMOTRON_NANO=
NEMOTRON_ULTRA=

# --- Demo budget protection (see plan Phase 3) ---
# Grades allowed per IP per hour on the public deployment.
GRADE_RATE_LIMIT_PER_HOUR=10
# Hard daily ceiling across all users. Past this the endpoint returns a friendly
# "demo quota reached" instead of spending the rest of the hackathon credits.
GRADE_DAILY_CAP=400

# --- Optional, for the spike's budget report ---
# Fill from the Token Factory pricing page, then re-run `npm run spike`.
PRICE_PER_1M_INPUT=
PRICE_PER_1M_OUTPUT=
CREDIT_BUDGET_USD=50
